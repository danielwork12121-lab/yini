# ─────────────────────────────────────────────────────────────
# Corner backend — copy to .env (same folder) and fill in. NEVER commit .env
# ─────────────────────────────────────────────────────────────

APP_ENV=dev
PORT=8000
# Comma-separated. The Next.js frontend in dev:
CORS_ORIGINS=http://localhost:3000

# ── Database ──
# Default is SQLite at backend/database/data/corner.db (created on first run).
# To use Postgres instead, paste a URL. The Supabase one is under Project Settings → Database:
#   postgresql+psycopg://postgres.<ref>:<password>@aws-0-us-west-1.pooler.supabase.com:6543/postgres
# (then `uv add psycopg[binary]`). Nothing else changes.
# DATABASE_URL=

# ── Auth ──
# dev      : trust X-Dev-User-Id / -Email / -Name headers, and POST /auth/dev-login. Postman + tests.
# supabase : verify Supabase access tokens (POST /auth/session exchanges one for our cookie).
AUTH_MODE=dev
SUPABASE_URL=
# Legacy projects: Project Settings → API → JWT Secret. Leave empty to use the project's JWKS instead.
SUPABASE_JWT_SECRET=
# Signs OUR session cookie. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me
SESSION_TTL_HOURS=720
COOKIE_SECURE=false          # true behind https
COOKIE_SAMESITE=lax          # "none" if frontend and backend are on different sites (needs COOKIE_SECURE=true)

# ── Agent ──
# mock   : deterministic, no network. gemini : real model.
LLM_PROVIDER=mock
# aistudio.google.com → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AGENT_USE_TOOLS=true          # let the model call get_entries_on_date / search_entries / get_recent_pair_summaries
AGENT_HISTORY_DAYS=7          # how many prior daily summaries each side gets in the prompt
LEAKCHECK_MIN_SPAN=6          # N consecutive words from the partner's raw text = leak → bullet dropped

# ── Nightly job ──
SCHEDULER_ENABLED=true
ANALYSIS_HOUR=0
ANALYSIS_MINUTE=0
ANALYSIS_TARGET=previous_day  # at 00:00 analyze yesterday. Use same_day with e.g. ANALYSIS_HOUR=22.
SCHEDULER_POLL_MINUTES=5

# ── Admin (POST /admin/analyze etc., header X-Admin-Token) ──
# With AUTH_MODE=supabase the server refuses to start unless this and SESSION_SECRET are 32+ chars.
ADMIN_TOKEN=dev-admin-token
