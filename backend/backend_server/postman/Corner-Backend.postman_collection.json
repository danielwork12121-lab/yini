{
  "info": {
    "name": "Corner Backend (local)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the folders top to bottom. Auth is dev-mode headers (X-Dev-User-*), so no Supabase or frontend is needed.\n\nStart the server: `uv run uvicorn app.main:app --reload`"
  },
  "item": [
    {
      "name": "0 \u00b7 Meta",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Admin-Token",
