    {
      "name": "3 \u00b7 Run the nightly analysis now",
      "item": [
        {
          "name": "Admin \u00b7 analyze {{day}} for all pairs",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Admin-Token",
                "value": "{{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/analyze",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "analyze"
              ]
            },
            "description": "With LLM_PROVIDER=mock this is instant. With gemini it takes a few seconds.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"day\": \"{{day}}\",\n  \"force\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('run done', () => pm.expect(pm.response.json()[0].status).to.eql('done'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Admin \u00b7 analyze one pair, force re-run",
          "request": {
