          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "A \u00b7 create pair",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Dev-User-Id",
                "value": "{{userA}}"
              },
              {
                "key": "X-Dev-User-Email",
                "value": "{{userA}}@dev.local"
              },
              {
                "key": "X-Dev-User-Name",
                "value": "{{userAName}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pairs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pairs"
              ]
            },
            "description": "Saves invite_code and pair id into the environment."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json(); pm.environment.set('inviteCode', j.invite_code); pm.environment.set('pairId', j.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "B \u00b7 join pair",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Dev-User-Id",
                "value": "{{userB}}"
              },
              {
                "key": "X-Dev-User-Email",
                "value": "{{userB}}@dev.local"
              },
              {
                "key": "X-Dev-User-Name",
                "value": "{{userBName}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pairs/join",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pairs",
                "join"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"invite_code\": \"{{inviteCode}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('partner is A', () => pm.expect(pm.response.json().partner.display_name).to.eql(pm.environment.get('userAName')));"
                ]
              }
            }
          ]
        },
        {
          "name": "A \u00b7 my pair",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Dev-User-Id",
                "value": "{{userA}}"
              },
              {
                "key": "X-Dev-User-Email",
                "value": "{{userA}}@dev.local"
              },
              {
                "key": "X-Dev-User-Name",
                "value": "{{userAName}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pairs/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pairs",
                "me"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('complete', () => pm.expect(pm.response.json().complete).to.be.true);"
                ]
              }
            }
          ]
        }
      ]
    },
