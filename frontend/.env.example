# ─────────────────────────────────────────────────────────────
# Yini — copy to .env.local and fill in. NEVER commit .env.local
# ─────────────────────────────────────────────────────────────

# Supabase — Project Settings > API
# The anon key is PUBLIC by design; RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. SERVER ONLY. Bypasses RLS entirely.
# Must never appear in any file under src/app/**/page.tsx or any "use client" file.
SUPABASE_SERVICE_ROLE_KEY=

# ── LLM providers (server only, no NEXT_PUBLIC_ prefix) ──
# Which provider runs the reasoning calls: "anthropic" | "openai"
LLM_PROVIDER=anthropic

# Anthropic — console.anthropic.com (NOT your claude.ai subscription)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CLASSIFY=claude-haiku-4-5
ANTHROPIC_MODEL_COMPOSE=claude-sonnet-4-5

# OpenAI — platform.openai.com (NOT your ChatGPT subscription)
OPENAI_API_KEY=
OPENAI_MODEL_CLASSIFY=gpt-4.1-mini
OPENAI_MODEL_COMPOSE=gpt-4.1

# ── Transcription ──
# "whisper" (needs OPENAI_API_KEY) | "browser" (Web Speech API) | "auto"
TRANSCRIBE_PROVIDER=auto
OPENAI_TRANSCRIBE_MODEL=whisper-1

# ── Leak check (adversarial reconstruction) ──
# Deliberately a DIFFERENT provider from LLM_PROVIDER when possible,
# so the attacker model shares no context with the writer model.
LEAKCHECK_PROVIDER=openai
LEAKCHECK_ENABLED=true

# ── Demo ──
# Enables the one-tap "I'm Avery / I'm Sam" seeded-couple login.
# MUST be false in any real deployment.
NEXT_PUBLIC_DEMO_MODE=true

# Sign in with Apple needs a paid Apple Developer account; leave false until it exists.
NEXT_PUBLIC_APPLE_SIGNIN=false
