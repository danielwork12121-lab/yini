{
  "info": {
    "name": "Corner (Next.js)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Every API route of the merged Next.js app, in run order. Needs `npm run dev` with NEXT_PUBLIC_DEMO_MODE=true.\n\nPostman keeps one cookie jar per host, so signing in as Sam replaces Avery's session. Run the folders top to bottom (or use the Collection Runner). Each route is one ontology action: see docs/ontology/actions/."
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// The device's local day, the same way the check-in screen computes it.",
          "const d = new Date(), pad = (n) => String(n).padStart(2, '0');",
          "pm.environment.set('today', `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0 \u00b7 Guards",
      "item": [
        {
          "name": "Today without a session \u2192 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/today",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "today"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
